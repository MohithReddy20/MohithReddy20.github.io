---
import Layout from './Layout.astro';
import type { Project } from '../data/projects';
interface Props { project: Project; next?: Project }
const { project, next } = Astro.props;
const flows: Record<string, string[]> = {
  'heart-disease': ['Validated application inputs', 'Flask + Random Forest', 'Risk estimate'],
  'asl-recognizer': ['Hand landmarks / MediaPipe', 'Recognition pipeline', 'Deque prediction smoothing'],
  'offline-nlp': ['SRS documents', 'Sequential local-model processing', 'Generated test cases'],
};
---
<Layout title={`${project.title} — Mohith Reddy Yannam`} description={project.summary}>
  <article class="case-study">
    <header class="case-hero container">
      <a class="back-link" href="/#projects">← Back to projects</a>
      <div class="hero-grid"><div>
        <p class="case-kicker">{project.category}</p><h1>{project.title}</h1>
        <p class="case-summary">{project.summary}</p>
        <div class="case-actions">{project.demo && <a class="btn btn-primary" href={project.demo} target="_blank" rel="noreferrer">View live demo ↗</a>}<a class="btn btn-outline" href="/#projects">All projects</a></div>
      </div><aside class="case-meta" aria-label="Project details">
        <div><span>Timeline</span><strong>{project.period}</strong></div><div><span>Focus</span><strong>{project.category}</strong></div><div><span>Stack</span><strong>{project.technologies.join(' · ')}</strong></div>
      </aside></div>
    </header>
    <div class="case-body container">
      <section class="case-section" aria-labelledby="architecture-title">
        <h2 class="section-label" id="architecture-title">System overview</h2>
        <ol class="architecture-flow">{flows[project.slug].map(step => <li>{step}</li>)}</ol>
        <p class="flow-note">High-level processing flow; only documented stages are shown.</p>
      </section>
      <section class="case-section case-section-lead"><h2 class="section-label">01 / The problem</h2><div class="case-copy"><slot name="problem" /></div></section>
      <section class="case-section case-section-split"><div><h2 class="section-label">02 / Engineering approach</h2><div class="case-copy"><slot name="approach" /></div></div><div><h2 class="section-label">03 / Constraints & decisions</h2><div class="case-copy"><slot name="decisions" /></div></div></section>
      <section class="case-section"><h2 class="section-label">04 / Results</h2><div class="results-grid"><div class="case-copy"><slot name="results" /></div><ul class="highlight-list">{project.highlights.map((item) => <li>{item}</li>)}</ul></div></section>
      <section class="case-section case-section-lead"><h2 class="section-label">05 / Context & limitations</h2><div class="case-copy"><slot name="limits" /></div></section>
    </div>
    <nav class="case-next container" aria-label="Case study navigation"><a href="/#projects">← Back to projects</a>{next && <a class="next-link" href={`/projects/${next.slug}`}>Next case <span>{next.title} →</span></a>}</nav>
  </article>
</Layout>
<style>
  .architecture-flow { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); padding:0; list-style:none; gap:1px; background:var(--faint); }
  .architecture-flow li { padding:1.3rem; background:var(--bg2); font:400 .8rem/1.7 'JetBrains Mono',monospace; }
  .architecture-flow li:not(:last-child)::after { content:' →'; color:var(--amber); }
  .flow-note { color:var(--muted); font-size:.8rem; }
  @media(max-width:700px) { .architecture-flow { grid-template-columns:1fr; } }
  .case-study { overflow:visible!important; }
  .case-study h1 { overflow-wrap:anywhere; }
  .case-study .section-label { white-space:normal; line-height:1.7; margin-bottom:1.2rem; }
  @media(max-width:700px) { .case-study .case-hero { padding-top:7rem; } }
  .case-study{overflow:hidden}.case-hero{padding:6.5rem 0 5rem;border-bottom:1px solid var(--border)}.back-link,.case-next a{color:var(--muted);font:400 .7rem 'JetBrains Mono',monospace;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}.back-link:hover,.case-next a:hover{color:var(--amber)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(16rem,.6fr);gap:clamp(3rem,10vw,10rem);align-items:end;margin-top:4rem}.case-kicker,.section-label{color:var(--amber);font:400 .7rem 'JetBrains Mono',monospace;letter-spacing:.12em;text-transform:uppercase}h1{max-width:850px;margin:.8rem 0 1.5rem;font:300 clamp(3.8rem,8vw,8rem)/.86 'Cormorant Garamond',serif;letter-spacing:-.04em}.case-summary{max-width:42rem;margin:0;color:var(--muted);font-size:clamp(1.1rem,2vw,1.35rem);line-height:1.55}.case-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2.25rem}.case-meta{border-top:1px solid var(--border)}.case-meta div{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--border)}.case-meta span{color:var(--muted);font:400 .68rem 'JetBrains Mono',monospace;text-transform:uppercase}.case-meta strong{max-width:65%;color:var(--text);font-size:.82rem;font-weight:400;text-align:right}.case-body{max-width:1050px}.case-section{padding:5rem 0;border-bottom:1px solid var(--border)}.case-section-lead{display:grid;grid-template-columns:minmax(10rem,.35fr) minmax(0,1fr);gap:3rem}.case-section-split,.results-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem)}.case-copy{max-width:46rem;color:var(--muted);font-size:1.04rem;line-height:1.85}.case-copy :global(p){margin:0 0 1.25rem}.case-copy :global(p:last-child){margin-bottom:0}.section-label{margin:0;white-space:nowrap}.highlight-list{margin:0;padding:0;list-style:none}.highlight-list li{padding:1rem 0 1rem 1.5rem;border-top:1px solid var(--border);color:var(--text);font:400 .9rem/1.45 'JetBrains Mono',monospace}.highlight-list li::before{content:'↗';color:var(--amber);margin-left:-1.5rem;margin-right:.8rem}.case-next{display:flex;justify-content:space-between;gap:2rem;padding:3.5rem 0 5rem}.next-link{display:flex;flex-direction:column;align-items:flex-end;gap:.5rem}.next-link span{color:var(--text);font:300 clamp(1.6rem,3vw,2.4rem) 'Cormorant Garamond',serif;text-transform:none;letter-spacing:0}@media(max-width:700px){.case-hero{padding:4rem 0 3.5rem}.hero-grid,.case-section-lead,.case-section-split,.results-grid{grid-template-columns:1fr;gap:1.5rem}.hero-grid{margin-top:3rem}h1{font-size:clamp(3.4rem,16vw,5.5rem)}.case-section{padding:3.5rem 0}.case-meta{margin-top:1rem}.case-next{align-items:flex-start;flex-direction:column;padding-bottom:3.5rem}.next-link{align-items:flex-start}}
</style>
